# Raiz de armazenamento dos projetos (volume no Docker)
STORAGE_ROOT=/data
# Conexão SQLAlchemy (driver psycopg v3)
DATABASE_URL=postgresql+psycopg://previewer:previewer@localhost:5432/previewer
# Chave secreta obrigatória, sem valor padrão
SECRET_KEY=troque-esta-chave
# Ambiente de execução: development | production | testing
FLASK_ENV=development

# OAuth App do GitHub (somente identidade; callback: http://localhost:8000/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Onboarding manual: logins do GitHub autorizados, separados por vírgula
GITHUB_ALLOWED_USERS=

# ngrok (proxy reverso para testes externos): token em https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Domínio estático do ngrok free (opcional, recomendado): reserve um em
# https://dashboard.ngrok.com/domains e use o mesmo no callback do OAuth App do GitHub.
# Ex.: NGROK_CMD=http app:8000 --url=https://seu-dominio.ngrok-free.app --log stdout
NGROK_CMD=

# Atrás de proxy (ex.: ngrok): respeitar X-Forwarded-* para o redirect_uri do OAuth.
# Deixe vazio em localhost.
TRUST_PROXY=
# Marca o cookie de sessão como Secure (só use servindo 100% por https).
SESSION_COOKIE_SECURE=
