# Raiz de armazenamento dos projetos (volume no Docker)
STORAGE_ROOT=/data
# Conexão SQLAlchemy (driver psycopg v3)
DATABASE_URL=postgresql+psycopg://previewer:previewer@localhost:5432/previewer
# Chave secreta obrigatória, sem valor padrão
SECRET_KEY=troque-esta-chave
# Ambiente de execução: development | production | testing
FLASK_ENV=development

# OAuth App do GitHub (somente identidade; callback: http://localhost:8000/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Onboarding manual: logins do GitHub autorizados, separados por vírgula
GITHUB_ALLOWED_USERS=
